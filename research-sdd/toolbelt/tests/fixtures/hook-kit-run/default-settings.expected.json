{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "<TARGET>/.claude/hooks/pkill-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "<TARGET>/.claude/hooks/retro-gate-stop.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"<KIT>/toolbelt/return-token-gate.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "<TARGET>/.claude/hooks/research-protocol.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"<KIT>/toolbelt/verify-skill-drift-hook.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
