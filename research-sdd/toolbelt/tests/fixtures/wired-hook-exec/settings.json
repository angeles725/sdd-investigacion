{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/quoted-noexec\""}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/plain-noexec"}]}
    ],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [
        {"type": "command", "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/bashwrapped-noexec"},
        {"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/plain-exec --flag"}
      ]}
    ],
    "PostToolUse": [
      {"hooks": [{"type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/absent-hook"}]}
    ]
  }
}
