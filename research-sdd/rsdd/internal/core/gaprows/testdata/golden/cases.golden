parse/single
  in  "| high | B1-G2 how it works | w | pending |\n"
  out empty=false n=1 | kind=1 line=1 id="B1-G2" block="1" pending=true text="how it works" cell="" source=""
parse/three
  in  "| Priority | Gap | Type | Status |\n|---|---|---|---|\n| high | B1-G1 first | w | pending |\n| low | B2-G1 middle | w | done |\n| medium | B3-G1 last | w | Pending review |"
  out empty=false n=3 | kind=1 line=3 id="B1-G1" block="1" pending=true text="first" cell="" source="" | kind=1 line=4 id="B2-G1" block="2" pending=false text="middle" cell="" source="" | kind=1 line=5 id="B3-G1" block="3" pending=true text="last" cell="" source=""
parse/escaped
  in  "| high | B4-G1 a \\| b \\\\| c | w | pending |\n"
  out empty=false n=1 | kind=1 line=1 id="B4-G1" block="4" pending=true text="a | b \\| c" cell="" source=""
parse/crlf
  in  "| high | B5-G1 text | w | pending |\r\n| — | B5-G2 old | w | done |\r\n| high | B5-G3 x |\r\n"
  out empty=false n=3 | kind=1 line=1 id="B5-G1" block="5" pending=true text="text" cell="" source="" | kind=2 line=2 id="" block="" pending=false text="" cell="B5-G2 old" source="" | kind=3 line=3 id="" block="" pending=false text="" cell="" source="| high | B5-G3 x |"
