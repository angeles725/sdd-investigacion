{
 "legacy": [
  "toolbelt/decompile-java.sh",
  "--javap",
  "{{input}}/Test.class"
 ],
 "rsdd": [
  "corroborate",
  "decompile",
  "--javap",
  "{{input}}/Test.class"
 ],
 "env": {
  "JAVA_HOME": "{{input}}/jdk",
  "VINEFLOWER_JAR": "{{input}}/vineflower.jar",
