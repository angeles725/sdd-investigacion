{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/research-sdd/toolbelt/sweep-retros-hook.sh\"",
            "timeout": 30,
            "statusMessage": "Sweeping research-sdd retros…"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/research-sdd/toolbelt/sweep-audits-hook.sh\"",
            "timeout": 30,
            "statusMessage": "Sweeping research-sdd audits…"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/research-sdd/toolbelt/sweep-breakthroughs-hook.sh\"",
            "timeout": 30,
            "statusMessage": "Sweeping research-sdd breakthrough ledger…"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/research-sdd/toolbelt/verify-registry-hook.sh\"",
            "timeout": 30,
            "statusMessage": "Reconciling research-sdd registry…"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/research-sdd/toolbelt/verify-kit-clean-hook.sh\"",
            "timeout": 15,
            "statusMessage": "Checking kit cleanliness…"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/research-sdd/toolbelt/sweep-tools-hook.sh\"",
            "timeout": 30,
            "statusMessage": "Sweeping research-sdd tool ledger…"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/research-sdd/toolbelt/verify-tool-catalog-hook.sh\"",
            "timeout": 15,
            "statusMessage": "Checking research-sdd tool catalog drift…"
          }
        ]
      }
    ]
  }
}
